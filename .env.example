TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Тема по умолчанию (хосты вне config/rdp_servers.json)
TELEGRAM_THREAD_ID=
# http://user:password@host:port
TELEGRAM_PROXY=
# default | drop
UNKNOWN_HOST_MODE=default
# Упоминание в RDP LOGIN FAILED, например @username; пусто - без упоминания
TELEGRAM_FAILED_MENTION=
# Пауза между сообщениями, с (лимит Telegram ~20 в минуту на группу)
TELEGRAM_MIN_INTERVAL=3
# Размер очереди отправки
TELEGRAM_QUEUE_SIZE=500
