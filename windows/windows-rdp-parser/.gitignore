# Секреты (токен бота, chat_id, прокси)
.env

# Сырые логи и выборки: содержат имена пользователей и IP
logs/

# Состояние парсера (SessionRegistry)
state/

# Очередь rsyslog -> парсер (сырые события)
spool/

# Python
__pycache__/
*.pyc

# Старые копии
*.copy

# Реальная конфигурация серверов (имена инфраструктуры, темы Telegram)
config/rdp_servers.json
